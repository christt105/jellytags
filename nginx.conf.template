server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # index.html, the JS/CSS bundles, sw.js and the manifest are all served
    # under unhashed filenames, so they must revalidate on every load or a
    # redeploy silently keeps serving the previous release out of the
    # browser's heuristic cache.
    # no-cache (not no-store) still lets nginx answer cheap 304s via ETag.
    location = / {
        add_header Cache-Control "no-cache" always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        add_header Cache-Control "no-cache" always;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache" always;
    }

    # Icons under /favicon/ don't change between releases.
    location /favicon/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # ...except the manifest itself, which can change between releases.
    location = /favicon/site.webmanifest {
        add_header Cache-Control "no-cache" always;
    }

    # Same-origin reverse proxy to Jellyfin: the browser never talks to
    # Jellyfin directly, so there's no cross-origin request and the admin
    # token never reaches the client bundle.
    location /jellyfin/ {
        proxy_pass ${VITE_JELLYFIN_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Emby-Token ${VITE_JELLYFIN_TOKEN};
    }
}
